<?xml version="1.0" encoding="utf-8"?>
<!-- 24dp slot with an 18dp knob, so the knob sits 3dp inside the track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="24dp" android:height="24dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="18dp" android:height="18dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/thumb" />
        </shape>
    </item>
</layer-list>
