    <string name="callout_setup_title">Run once on a computer</string>
    <string name="callout_setup_text">Connect the tablet via USB or wireless debugging and run this command. Then reopen the app.</string>
    <string name="callout_exempt_title">Keep running when unused</string>
    <string name="callout_exempt_text">Android pauses apps that are not opened for a few months. After the next restart the icon would be back. This command exempts the app from that and from battery limits. Then reopen the app.</string>
